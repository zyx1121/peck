{
  "name": "peck",
  "private": true,
  "version": "0.1.0",
  "description": "Point it out. A Chromium browser for visual feedback and coding agents.",
  "author": "Loki",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs && node scripts/icon.mjs",
    "start": "electron .",
    "package:mac": "node scripts/package.mjs darwin arm64",
    "package:linux": "node scripts/package.mjs linux x64",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "theme:sync": "node scripts/sync-theme.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "^10",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "commander": "^14.0.3",
    "electron": "44.5.1",
    "esbuild": "^0.27.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.12"
  }
}
